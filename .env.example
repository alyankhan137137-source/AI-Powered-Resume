# Copy this file to .env (same folder as pubspec.yaml) and fill in real values.
# .env is already gitignored — never commit real keys.

# Gemini AI (Direct SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Fallback/Legacy)
OPENAI_API_KEY=

# Optional — only needed for the LinkedIn OAuth import path.
LINKEDIN_CLIENT_ID=
LINKEDIN_REDIRECT_URI=
BACKEND_AUTH_URL=
